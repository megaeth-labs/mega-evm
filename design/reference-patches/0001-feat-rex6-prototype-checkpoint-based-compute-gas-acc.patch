 crates/mega-evm/src/limit/limit.rs            |  69 ++++
 .../tests/rex6/checkpoint_accounting.rs       | 185 ++++++++++
 crates/mega-evm/tests/rex6/main.rs            |   1 +
 4 files changed, 575 insertions(+), 20 deletions(-)
 create mode 100644 crates/mega-evm/tests/rex6/checkpoint_accounting.rs

